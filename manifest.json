{
  "manifest_version": 3,
  "name": "Response Mocker",
  "version": "1.0.0",
  "description": "Подмена ответов fetch и XMLHttpRequest по правилам. Работает полностью локально, без аккаунтов и серверов.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Response Mocker"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
